{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'schedule:weekly',
    ':widenPeerDependencies',
    ':maintainLockFilesWeekly',
  ],
  ignorePresets: ['replacements:tsconfig-bases-node'],
  ignorePaths: ['**/tests/**', '**/node_modules/**'],
  labels: ['dependencies'],
  minimumReleaseAge: '3 days',
  prHourlyLimit: 0,
  postUpdateOptions: ['pnpmDedupe'],
  ignoreDeps: [
    // manually update some packages
    'pnpm',
    'typescript',
    // align Node.js version minimum requirements
    '@types/node',
    'node',
  ],
  packageRules: [
    {
      groupName: 'dev tooling',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies', 'devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      semanticCommitType: 'chore',
    },
    {
      groupName: 'vite and frameworks',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies', 'devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      matchPackageNames: [
        'vite',
        '@vitejs/**',
        'vue',
        'react',
        'react-dom',
        '@types/react',
        '@types/react-dom',
        'svelte',
        '@sveltejs/kit',
        '@sveltejs/vite-plugin-svelte',
        'express',
        '@types/express',
        'http-proxy-middleware',
      ],
    },
    {
      groupName: 'checker integrations',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies', 'devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      matchPackageNames: [
        '@biomejs/biome',
        'eslint',
        'typescript-eslint',
        'oxlint',
        'stylelint',
        'stylelint-config-standard',
        'meow',
        'svelte-check',
        'vue-tsc',
        '@vue/language-core',
        'sv',
        '@sveltejs/sv-utils',
      ],
    },
    {
      groupName: 'stylelint',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies', 'devDependencies'],
      matchUpdateTypes: ['major'],
      matchPackageNames: ['stylelint', 'stylelint-config-standard'],
    },
    {
      groupName: 'runtime dependencies',
      matchFileNames: ['packages/vite-plugin-checker/package.json'],
      matchDepTypes: ['dependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      semanticCommitType: 'fix',
    },
    {
      groupName: 'github actions',
      matchManagers: ['github-actions'],
    },
  ],
}
