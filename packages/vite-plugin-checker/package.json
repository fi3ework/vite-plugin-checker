{
  "name": "vite-plugin-checker",
  "version": "1.0.1",
  "description": "Vite plugin that runs TypeScript type checker on a separate process.",
  "keywords": [
    "vite",
    "vite-plugin",
    "typescript"
  ],
  "homepage": "https://github.com/fi3ework/vite-plugin-checker",
  "bugs": "https://github.com/fi3ework/vite-plugin-checker/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fi3ework/vite-plugin-checker.git"
  },
  "license": "MIT",
  "author": "fi3ework <fi3ework@gmail.com>",
  "type": "module",
  "exports": {
    ".": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "!dist/checkers/vueTsc/typescript-vue-tsc"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:ui",
    "build:test": "tsdown --config tsdown.test.config.ts && pnpm run build:ui",
    "build:ui": "pnpm --filter @vite-plugin-checker/ui run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsdown --watch",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\" && pnpm run build"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "chokidar": "^6.0.0",
    "clickable-path": "^0.1.1",
    "picomatch": "^4.0.4",
    "tinyexec": "^1.2.4"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@vitejs/devtools-kit": "^0.8.2",
    "@vue/language-core": "~3.3.0",
    "meow": "^14.0.0",
    "modern-tar": "^0.8.0",
    "stylelint": "^17.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vue-tsc": "~3.3.0"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.4.12",
    "eslint": ">=9.39.4",
    "meow": "^13.2.0 || ^14.0.0",
    "optionator": "^0.9.4",
    "oxlint": ">=1",
    "stylelint": ">=16.26.1",
    "svelte-check": ">=4",
    "typescript": "*",
    "vite": ">=5.4.21",
    "vue-tsc": "~2.2.10 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "meow": {
      "optional": true
    },
    "optionator": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "svelte-check": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue-tsc": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  }
}
