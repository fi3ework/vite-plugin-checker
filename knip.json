{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*", "playground/*"],
      "ignoreDependencies": ["oxlint"]
    },
    "docs": {
      "entry": [".vitepress/components/*.vue"]
    },
    "packages/vite-plugin-checker": {
      "entry": [
        "src/**/*.ts",
        "src/checkers/vueTsc/languagePlugins.cjs",
        "__tests__/fixtures/tsDiagnostic.ts"
      ],
      "ignoreDependencies": ["eslint", "svelte-check"]
    },
    "playground/backend-integration": {
      "entry": ["src/*.{js,ts,tsx}", "__test__/serve.js"]
    },
    "playground/docs-screenshot": {
      "entry": ["vite.devtools.config.js"]
    },
    "playground/multiple-servers": {
      "entry": ["widget/vite.config.js", "widget/src/*.ts"]
    }
  }
}
